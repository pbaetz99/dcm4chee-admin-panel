# nginx fuer den OHIF-Viewer und die PACS-Verwaltung (/admin/). Wird im Container "ohif" als
# /etc/nginx/conf.d/default.conf eingebunden (siehe docker-compose.example.yml), steht also im http-Block.
# English: nginx config for the OHIF viewer and the admin panel. Replace every value marked ANPASSEN.
#
# Ablauf: jede Anfrage fragt oauth2-proxy (Dienst ohif-auth) per auth_request. Ohne gueltige Sitzung geht es zur
# Anmeldung (Entra ID oder ein anderer OIDC-Anbieter), danach zurueck auf die aufgerufene Adresse. /admin/ und alle
# aendernden dcm4chee-Aufrufe verlangen zusaetzlich die Admin-Gruppe (location /oauth2/auth-admin).
#
# Pfade im Container (muessen zu den volumes in docker-compose.example.yml passen):
#   /srv/pacs-admin/admin/            web/admin aus dem Repo, nur lesen
#   /srv/pacs-admin/status/           status.json von dashboard-status.py (Host: $PACS_ADMIN_VAR/status), nur lesen
#   /run/pacs-admin/verwaltung.sock   Hilfsdienst verwaltung-dienst.py (Host: $PACS_SOCKET)
#   /run/pacs-admin/protokoll.sock    Protokoll-Eingang des Hilfsdienstes (Host: $PACS_LOG_SOCKET)
#   /etc/nginx/tls/                   Zertifikat und Schluessel
# nginx laeuft im OHIF-Image als uid 101. Der Hilfsdienst legt beide Sockets mit diesem Besitzer an.
#
# Standortwerte (alle mit ANPASSEN markiert):
#   server_name pacs.example.org, Zertifikatspfade, Upstreams arc und ohif-auth, ADMIN-GRUPPEN-ID.
#   AE-Titel DCM4CHEE (Archiv) und IOCM_QUALITY (Ansicht der abgelehnten Studien) stehen in mehreren map- und
#   location-Zeilen: `grep -n 'DCM4CHEE\|IOCM_QUALITY' nginx.conf` zeigt alle Stellen. 99DCM4CHEE ist das
#   Codierschema der Rueckholung, kein AE-Titel, und bleibt. Die Werte muessen zu aet/iocmAet in
#   web/admin/config.js und ARC_AET in /etc/default/pacs-admin passen.


# ---- Protokoll ---------------------------------------------------------------------------------------------------
# nginx schickt jede Protokollzeile per syslog an den Hilfsdienst, der sie verschluesselt ablegt (pacsdb.py).
# Kennungen: zugriffe = jede Anfrage mit Konto, ereignisse = Studien- und Patientensuche und geoeffnete Studien,
# admin = Aenderungen. Der Dienst liest die Feldnamen, nicht umbenennen. Nach docker logs geht absichtlich nichts
# (Patientendaten in den Adressen); zur Fehlersuche voruebergehend "access_log /dev/stdout pacs;" im server ergaenzen.
# u = Anmeldename (preferred_username, ohne diesen Claim die E-Mail; kann sich aendern), sub = feste Kennung des
# Kontos beim Anbieter
log_format pacs escape=json '{"t":"$time_iso8601","u":"$pacs_user","sub":"$pacs_sub","ip":"$remote_addr","r":"$request_uri","status":$status}';
# Aenderungen (Quelle admin): dazu Methode, Beschreibung der Seite (k, URL-kodiert aus X-PACS-Admin) und neue Werte
# (body, nur wenn der Inhalt in client_body_buffer_size passt)
log_format pacs_admin escape=json '{"t":"$time_iso8601","u":"$pacs_user","sub":"$pacs_sub","ip":"$remote_addr","r":"admin","m":"$request_method","uri":"$request_uri","status":$status,"k":"$http_x_pacs_admin","body":"$request_body"}';

# Konto fuer Protokoll und X-Auth-User: preferred_username; manche Anbieter (z. B. Google) senden ihn nicht, dann die
# E-Mail (beide von oauth2-proxy mit --set-xauthrequest, siehe auth_request_set im server)
map $pacs_login $pacs_user {
    ""       $pacs_email;
    default  $pacs_login;
}

# Ereignisse: Studien- und Patientensuche (auch der abgelehnten Studien), Serienliste (= Studie geoeffnet), Metadaten,
# WADO-URI, nur GET. /_dcm4chee: dieselben Aufrufe aus der dcm4chee-Oberflaeche (nach dem rewrite im server; dort
# ist POST .../rs/studies ein Hochladen, keine Suche). AE-Titel ANPASSEN.
map "$request_method $uri" $pacs_ereignis {
    "~^GET (/_dcm4chee)?/dcm4chee-arc/aets/(DCM4CHEE/rs/(studies(/[^/]+/series)?|patients)|IOCM_QUALITY/rs/studies)$"  1;
    "~^GET (/_dcm4chee)?/dcm4chee-arc/aets/DCM4CHEE/rs/studies/.+/instances/[^/]+/metadata$"                           1;
    "~^GET (/_dcm4chee)?/dcm4chee-arc/aets/DCM4CHEE/wado$"                                                              1;
    default                                                                                                             0;
}

# /admin/dienst/: POST nur mit X-PACS-Admin (setzt nur die Verwaltungsseite), nur POSTs ins Verwaltungsprotokoll
map "$request_method:$http_x_pacs_admin" $pacs_post_ohne_admin {
    "POST:"  1;
    default  0;
}
map $request_method $pacs_ist_post {
    POST     1;
    default  0;
}

# Studienliste neueste zuerst: OHIF schickt keine Reihenfolge und sortiert nur die geladene Seite, dcm4chee liefert
# ohne orderby die aeltesten zuerst
map $arg_orderby $pacs_orderby {
    ""      "&orderby=-StudyDate,-StudyTime";
    default "";
}

# OPTIONAL dcm4chee-UI: Aufrufe der dcm4chee-Oberflaeche erkennt nginx am Referer https://<Host>/dcm4chee-arc/ui2/.
# Der Host im Referer muss $host dieser Anfrage sein (\1), ohne Port: Browser lassen den Standardport 443 weg. Ein
# Referer mit Port (andere Seite auf demselben Rechnernamen, z. B. Portainer auf 9443), mit fremdem Host, mit http oder
# ohne Referer ergibt 0, solche Aufrufe gehen an die gesperrten locations unten.
# Ohne den optionalen Abschnitt duerfen beide maps stehen bleiben, ohne das if im server wirken sie nicht.
map "$host $http_referer" $pacs_dcm4chee_ui {
    "~^(\S+) https://\1/dcm4chee-arc/ui2/"  1;   # ANPASSEN, nur wenn nginx von aussen nicht auf 443 laeuft: https://\1:PORT/
    default                                 0;
}
# OPTIONAL dcm4chee-UI: alles ausser Lesen kommt ins Verwaltungsprotokoll
map $request_method $pacs_aendernd {
    GET      0;
    HEAD     0;
    OPTIONS  0;
    default  1;
}


# ---- http: nur Umleitung auf https (Host-Port 80 -> Container 8080) ----------------------------------------------
server {
    listen 8080 default_server;
    server_name _;
    access_log off;
    return 301 https://$host$request_uri;
}


# ---- https (Host-Port 443 -> Container 8443) ---------------------------------------------------------------------
server {
    listen 8443 ssl default_server;
    http2 on;                                          # braucht nginx 1.25.1 oder neuer
    server_name pacs.example.org;                      # ANPASSEN

    ssl_certificate     /etc/nginx/tls/server.crt;     # ANPASSEN, mit Zwischenzertifikaten
    ssl_certificate_key /etc/nginx/tls/server.key;     # ANPASSEN, lesbar fuer uid 101
    ssl_protocols       TLSv1.2 TLSv1.3;

    # die Sitzung steckt im Cookie, mit vielen Gruppen im Token wird es gross
    large_client_header_buffers 4 16k;
    # Weiterleitungen relativ (/admin -> /admin/), sonst nennt nginx den Container-Port 8443
    absolute_redirect off;

    root /usr/share/nginx/html;                        # OHIF aus dem Image
    gzip_static on;
    gunzip on;
    gzip on;
    gzip_proxied any;
    gzip_types application/json application/dicom+json application/javascript text/css;

    # DNS von Docker. Upstreams werden pro Anfrage aufgeloest: nach dem Neuerzeugen haben Container eine neue IP.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $arc  http://arc:8080;                         # ANPASSEN: Containername und http-Port von dcm4chee-arc
    set $auth http://ohif-auth:4180;                   # ANPASSEN: oauth2-proxy (Dienst ohif-auth)

    # Protokoll fuer alles ohne eigenes access_log (Pfad = PACS_LOG_SOCKET im Container)
    access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=zugriffe pacs;
    access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=ereignisse pacs if=$pacs_ereignis;

    # alles hinter der Anmeldung, das Konto kommt ins Protokoll (braucht --set-xauthrequest bei oauth2-proxy)
    auth_request /oauth2/auth;
    auth_request_set $pacs_login $upstream_http_x_auth_request_preferred_username;   # -> $pacs_user (map oben)
    auth_request_set $pacs_email $upstream_http_x_auth_request_email;
    auth_request_set $pacs_sub   $upstream_http_x_auth_request_user;
    error_page 401 = /oauth2/start;

    # OPTIONAL dcm4chee-UI: Aufrufe der Oberflaeche an die volle Schnittstelle (/_dcm4chee/ unten), vor der Auswahl
    # der location. Ohne den optionalen Abschnitt diese drei Zeilen loeschen.
    if ($pacs_dcm4chee_ui) {
        rewrite ^/dcm4chee-arc/ /_dcm4chee$uri last;
    }

    # Cross-Origin-Isolation fuer SharedArrayBuffer (OHIF 3D, MPR). add_header in einer location ersetzt diese
    # Zeilen, darum stehen sie dort jeweils noch einmal.
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Embedder-Policy require-corp always;
    add_header Cross-Origin-Resource-Policy same-origin always;

    # ---- Anmeldung (oauth2-proxy) -----------------------------------------------------------------------------------
    # Anmelden, Rueckkehr vom Anbieter (/oauth2/callback), Abmelden, userinfo (Kontoname oben in /admin/)
    location /oauth2/ {
        auth_request off;
        proxy_pass $auth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Uri $request_uri;   # Kopfzeilen vom Browser nie durchreichen
        proxy_set_header X-Auth-Request-Redirect $request_uri;
    }

    # Pruefung je Anfrage: angemeldet und in einer der --allowed-group von oauth2-proxy. Mit Variable im proxy_pass
    # immer mit fester URI, sonst geht die Original-URI mit.
    location = /oauth2/auth {
        internal;
        proxy_pass $auth/oauth2/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Uri $request_uri;
    }

    # Pruefung fuer /admin/ und alle Aenderungen: nur die Admin-Gruppe. Entra ID: Objekt-ID der Gruppe (Token muss
    # den Claim groups enthalten), andere OIDC-Anbieter: Gruppenname wie im Claim groups. Ohne Ersetzen kommt niemand
    # in die Verwaltung.
    location = /oauth2/auth-admin {
        internal;
        proxy_pass $auth/oauth2/auth?allowed_groups=ADMIN-GRUPPEN-ID;   # ANPASSEN
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Uri $request_uri;
    }

    # ---- OHIF-Viewer ------------------------------------------------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Startseite nie ungeprueft aus dem Browser-Cache: ein altes index.html laedt die Skripte ohne Sitzung, bekommt nur
    # Umleitungen zur Anmeldung und die Seite bleibt weiss
    location = /index.html {
        add_header Cache-Control no-cache;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }

    # eigene app-config.js (Datenquelle /dcm4chee-arc/aets/DCM4CHEE/rs) ausliefern, nicht die app-config.js.gz aus
    # dem Image
    location = /app-config.js {
        gzip_static off;
        add_header Cache-Control no-cache;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }

    # alles unter /dcm4chee-arc/, das unten nicht ausdruecklich erlaubt ist
    location /dcm4chee-arc/ {
        return 404;
    }

    # ---- OPTIONAL dcm4chee-UI: dcm4chee-Oberflaeche ueber dieselbe Anmeldung, ohne Keycloak -------------------------
    # Voraussetzung: arc laeuft ohne Keycloak (Image dcm4chee-arc-psql, nicht -secure/-secure-ui). Zugang nur fuer die
    # Admin-Gruppe. arc selbst (8080/8443) sollte von aussen gesperrt sein (Reiter Firewall).
    # Einstieg /dcm4chee-arc/ui2/ (Link in /admin/). Die Oberflaeche ruft danach beliebige Adressen unter
    # /dcm4chee-arc/ auf, immer mit Referer https://<dieser Host>/dcm4chee-arc/ui2/...; das if im server schickt sie
    # nach /_dcm4chee/, dort ist alles erlaubt (map $pacs_dcm4chee_ui oben). Die Sperren und X-PACS-Admin der
    # Verwaltung gelten hier nicht, die Oberflaeche ist das Werkzeug des Herstellers.
    # Aenderungen (alles ausser GET/HEAD/OPTIONS) stehen mit Konto im Protokoll.
    # Abschalten: diesen Abschnitt bis "Ende OPTIONAL" und das if im server loeschen.
    location = /dcm4chee {
        return 301 /dcm4chee-arc/ui2/;
    }
    # Einstieg: dcm4chee liefert hier nur ein Weiterleitungs-Skript ohne Content-Type (manche Browser laden es dann
    # nicht). Gleiches Skript mit Typ, Vorgabe Deutsch. Es loescht vorher eine im Browser gemerkte Keycloak-Einstellung
    # der Oberflaeche (sonst springt sie trotz leerer keycloak.json zu Keycloak).
    location = /dcm4chee-arc/ui2/ {
        default_type text/html;
        add_header Cache-Control no-cache always;
        return 200 "<!doctype html><script>Object.keys(localStorage).forEach(function(k){if(k.indexOf('keycloak_config_')===0||k.indexOf('kc-callback-')===0)localStorage.removeItem(k);});var l=localStorage.getItem('current_language')||'de';location.replace('/dcm4chee-arc/ui2/'+l+'/index.html');</script>";
    }
    # Die Oberflaeche fragt keycloak.json: leer = ohne Keycloak, sonst Weiterleitung zu Keycloak. arc liefert auch ohne
    # Keycloak Standardwerte, darum antwortet nginx selbst (beide Wege, mit und ohne Referer).
    location = /dcm4chee-arc/ui2/rs/keycloak.json {
        default_type application/json;
        add_header Cache-Control no-store always;
        return 200 '{}';
    }
    location = /_dcm4chee/dcm4chee-arc/ui2/rs/keycloak.json {
        internal;
        default_type application/json;
        add_header Cache-Control no-store always;
        return 200 '{}';
    }
    location ^~ /dcm4chee-arc/ui2/ {
        auth_request /oauth2/auth-admin;
        proxy_pass $arc$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control no-cache always;
    }
    location ^~ /_dcm4chee/ {
        internal;
        auth_request /oauth2/auth-admin;
        client_max_body_size 0;          # Hochladen von DICOM ueber die Oberflaeche
        client_body_buffer_size 64k;     # kleine Aenderungen (JSON) stehen mit Inhalt im Protokoll
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=zugriffe pacs;
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=ereignisse pacs if=$pacs_ereignis;
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=admin pacs_admin if=$pacs_aendernd;
        proxy_pass $arc$request_uri;     # Original-Adresse unveraendert (kodierte Zeichen wie %5E bleiben)
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        add_header Cache-Control no-store always;
    }
    # ---- Ende OPTIONAL dcm4chee-UI ----------------------------------------------------------------------------------

    # ---- Verwaltung /admin/, nur Admin-Gruppe -----------------------------------------------------------------------
    location = /admin {
        return 301 /admin/;
    }
    # die Seite selbst (index.html, admin.css, config.js)
    location /admin/ {
        auth_request /oauth2/auth-admin;
        alias /srv/pacs-admin/admin/;
        add_header Cache-Control no-cache;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }
    # Zahlen fuer die Uebersicht (status.json von dashboard-status.py, per cron alle 5 Minuten), ohne Patientendaten
    location /admin/daten/ {
        auth_request /oauth2/auth-admin;
        alias /srv/pacs-admin/status/;
        gzip_static off;
        add_header Cache-Control no-store always;   # immer der aktuelle Stand
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }
    # Hilfsdienst auf dem Host (verwaltung-dienst.py, systemd pacs-verwaltung) ueber den Unix-Socket (PACS_SOCKET):
    # Platten, Firewall, Protokoll lesen. Der Dienst kennt das Konto nur aus X-Auth-User und den PC aus X-Real-IP
    # (Firewall: eigenen PC nicht aussperren). Docker gibt die echte Client-IP weiter; steht noch ein Proxy davor,
    # stimmt $remote_addr nicht.
    location ^~ /admin/dienst/ {
        auth_request /oauth2/auth-admin;
        limit_except GET POST { deny all; }
        if ($pacs_post_ohne_admin) { return 403; }
        client_max_body_size 64k;        # Firewall: alle Regeln in einer Anfrage
        client_body_buffer_size 64k;
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=zugriffe pacs;
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=admin pacs_admin if=$pacs_ist_post;
        proxy_pass http://unix:/run/pacs-admin/verwaltung.sock:;
        proxy_set_header X-Auth-User $pacs_user;       # Kopfzeilen vom Browser mit diesen Namen werden ersetzt
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-PACS-Admin "";
        proxy_read_timeout 300s;
        add_header Cache-Control no-store always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }

    # ---- dcm4chee-Aufrufe der Verwaltung, mit Sperren gegen Fehlbedienung -------------------------------------------
    # Aenderungen brauchen die Kopfzeile X-PACS-Admin (setzt nur die Verwaltungsseite, fremde Seiten koennen das ohne
    # CORS nicht) und stehen mit Konto, PC, Anfrage und neuen Werten im Protokoll (Quelle admin). Sperren:
    #   - Studie aendern nur mit StudyInstanceUID (ohne trifft dcm4chee ALLE Studien)
    #   - Studie verschieben nur mit updatePolicy=PRESERVE (sonst ueberschreibt dcm4chee den Zielpatienten)
    #   - Patient aendern nie mit merge (heisst dort zusammenfuehren)
    #   - endgueltig loeschen nur ueber IOCM_QUALITY, dcm4chee loescht dort nur Abgelehntes
    # Diese regex-locations muessen vor den Lese-locations fuer OHIF weiter unten stehen (die erste passende gewinnt).
    # AE-Titel ANPASSEN (siehe Kopf der Datei).

    # lesen: Patienten, abgelehnte Studien (Ansicht der AE IOCM_QUALITY)
    location ~ ^/dcm4chee-arc/aets/(DCM4CHEE/rs/patients|IOCM_QUALITY/rs/studies)$ {
        auth_request /oauth2/auth-admin;
        limit_except GET { deny all; }
        proxy_pass $arc;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        add_header Cache-Control no-store always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }
    # ablehnen (113001^DCM), zurueckholen, zusammenfuehren
    location ~ "^/dcm4chee-arc/aets/(DCM4CHEE/rs/studies/[0-9.]+/reject/113001\^DCM|IOCM_QUALITY/rs/studies/[0-9.]+/reject/REVOKE_REJECTION\^99DCM4CHEE|DCM4CHEE/rs/patients/[^/]+/merge/[^/]+)$" {
        auth_request /oauth2/auth-admin;
        limit_except POST { deny all; }
        if ($http_x_pacs_admin = "") { return 403; }
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=zugriffe pacs;
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=admin pacs_admin;
        proxy_pass $arc;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-PACS-Admin "";
        proxy_read_timeout 300s;
        add_header Cache-Control no-store always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }
    # Studie bearbeiten: nur genau eine Studie
    location = /dcm4chee-arc/aets/DCM4CHEE/rs/studies/update {
        auth_request /oauth2/auth-admin;
        limit_except POST { deny all; }
        if ($http_x_pacs_admin = "") { return 403; }
        if ($arg_StudyInstanceUID !~ "^[0-9.]+$") { return 403; }
        client_body_buffer_size 64k;
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=zugriffe pacs;
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=admin pacs_admin;
        proxy_pass $arc;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-PACS-Admin "";
        proxy_read_timeout 300s;
        add_header Cache-Control no-store always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }
    # Studie zu anderem Patienten: Zielpatient bleibt unveraendert
    location ~ "^/dcm4chee-arc/aets/DCM4CHEE/rs/studies/[0-9.]+/patient$" {
        auth_request /oauth2/auth-admin;
        limit_except POST { deny all; }
        if ($http_x_pacs_admin = "") { return 403; }
        if ($arg_updatePolicy != "PRESERVE") { return 403; }
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=zugriffe pacs;
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=admin pacs_admin;
        proxy_pass $arc;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-PACS-Admin "";
        proxy_read_timeout 300s;
        add_header Cache-Control no-store always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }
    # Patient bearbeiten: ganzer Datensatz per PUT, nie merge
    location ~ "^/dcm4chee-arc/aets/DCM4CHEE/rs/patients/[^/]+$" {
        auth_request /oauth2/auth-admin;
        limit_except PUT { deny all; }
        if ($http_x_pacs_admin = "") { return 403; }
        if ($arg_merge) { return 403; }
        client_body_buffer_size 64k;
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=zugriffe pacs;
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=admin pacs_admin;
        proxy_pass $arc;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-PACS-Admin "";
        proxy_read_timeout 300s;
        add_header Cache-Control no-store always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }
    # abgelehnte Studie endgueltig loeschen
    location ~ "^/dcm4chee-arc/aets/IOCM_QUALITY/rs/studies/[0-9.]+$" {
        auth_request /oauth2/auth-admin;
        limit_except DELETE { deny all; }
        if ($http_x_pacs_admin = "") { return 403; }
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=zugriffe pacs;
        access_log syslog:server=unix:/run/pacs-admin/protokoll.sock,nohostname,tag=admin pacs_admin;
        proxy_pass $arc;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-PACS-Admin "";
        proxy_read_timeout 300s;
        add_header Cache-Control no-store always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }

    # ---- DICOMweb nur lesend (OHIF und die Studiensuche der Verwaltung), alle angemeldeten Konten -------------------
    # Studiensuche (QIDO) neueste zuerst, siehe map $pacs_orderby
    location = /dcm4chee-arc/aets/DCM4CHEE/rs/studies {
        limit_except GET { deny all; }
        proxy_pass $arc$uri?$args$pacs_orderby;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control no-store always;   # jeder Abruf geht zum Server (Protokoll), nichts im PC-Cache
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }
    # QIDO/WADO-RS auf Studien, Serien, Instanzen und WADO-URI, nur GET. Alles andere von dcm4chee (Worklist,
    # Steuerung, Aendern) ist hierueber nicht erreichbar.
    location ~ ^/dcm4chee-arc/aets/DCM4CHEE/(rs/(studies|series|instances)|wado)(/|$) {
        limit_except GET { deny all; }
        proxy_pass $arc;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control no-store always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }
}
